# magecode environment variables
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Get your key at https://build.nvidia.com/settings
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: self-hosted SearXNG instance for reliable, keyless web search.
# The instance must have the JSON format enabled (search.formats: [json]).
# When unset, web search falls back to DuckDuckGo (HTML + Lite).
# SEARXNG_URL=https://searx.example.org
